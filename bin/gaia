#!/usr/bin/env python3
"""
gaia -- Unified Gaia CLI

Entry point that discovers subcommand plugins from bin/cli/ and dispatches
to the matching handler. Zero external dependencies (stdlib only).

Usage:
    python bin/gaia <subcommand> [options]
    python bin/gaia --help
    python bin/gaia status [--json]
    python bin/gaia doctor [--json] [--fix]
"""

import argparse
import importlib
import importlib.util
import os
import subprocess
import sys
from pathlib import Path

# Ensure the package root is on sys.path so submodules resolve correctly.
_SCRIPT_DIR = Path(__file__).resolve().parent
_PACKAGE_ROOT = _SCRIPT_DIR.parent
if str(_PACKAGE_ROOT) not in sys.path:
    sys.path.insert(0, str(_PACKAGE_ROOT))
# Also ensure bin/ is on the path so bin/cli/ resolves as a package.
if str(_SCRIPT_DIR) not in sys.path:
    sys.path.insert(0, str(_SCRIPT_DIR))

_CLI_DIR = _SCRIPT_DIR / "cli"

# Subcommands that must NOT trigger the lazy DB bootstrap:
#   - install:   bootstraps the DB itself (Step 1); double-bootstrap is wasteful.
#   - uninstall: tearing Gaia down -- recreating the DB would be perverse.
_LAZY_BOOTSTRAP_SKIP = frozenset({"install", "uninstall"})


def _resolve_db_path():
    """Resolve the gaia.db path the store itself will use.

    Delegates to ``gaia.paths.resolver.db_path`` rather than re-deriving the
    path, because the bootstrap below CREATES a database at whatever this
    returns. When the two resolvers disagreed, that made this function a decoy
    factory: it honored ``GAIA_DB`` while the store honored only
    ``GAIA_DATA_DIR``, so ``GAIA_DB=<x> gaia <subcommand>`` bootstrapped a
    complete, fully schema'd database at ``<x>`` and then read and wrote the
    real user database -- silently, with a success message, and with the decoy
    left behind as evidence that the isolation had worked.

    A caller must not be able to reach that state by asking for isolation the
    wrong way, so there is now exactly ONE resolver. The fallback keeps the
    resolution ladder identical (``GAIA_DB``, then ``GAIA_DATA_DIR``, then
    ``~/.gaia``) for the case where the import cannot be satisfied at all,
    since the bootstrap is best-effort and must never break the CLI.
    """
    try:
        from gaia.paths.resolver import db_path
        return db_path()
    except Exception:  # noqa: BLE001
        env = os.environ.get("GAIA_DB")
        if env:
            return Path(env).expanduser()
        data_dir = os.environ.get("GAIA_DATA_DIR")
        if data_dir:
            return Path(data_dir).expanduser() / "gaia.db"
        return Path("~/.gaia/gaia.db").expanduser()


def _ensure_db_bootstrapped(subcommand):
    """Lazily bootstrap the resolved gaia.db on first CLI use if it is absent.

    The path comes from ``_resolve_db_path()``, i.e. from the same resolver the
    store reads, so what gets bootstrapped is always the database the CLI will
    then use -- never a second one alongside it.

    This is the non-invasive replacement for the removed npm ``postinstall``
    hook. It runs on the first real CLI use rather than at package-install
    time, so it behaves identically under npm, pnpm (which ignores lifecycle
    scripts by default), and the Claude Code plugin install -- none of which
    are required to run a postinstall step. Best-effort and quiet: a failure
    here never blocks the requested subcommand (the command surfaces its own
    DB error, and ``gaia doctor`` reports the root cause).
    """
    if subcommand in _LAZY_BOOTSTRAP_SKIP:
        return
    try:
        db = _resolve_db_path()
        if db.exists():
            return
        # Cross-platform Python bootstrapper (module sqlite3, no `sqlite3` CLI
        # and no `bash` in PATH required -- works on Windows). See
        # scripts/bootstrap_database.py.
        bootstrap = _PACKAGE_ROOT / "scripts" / "bootstrap_database.py"
        if not bootstrap.is_file():
            return
        env = os.environ.copy()
        env["GAIA_DB"] = str(db)
        subprocess.run(
            [sys.executable or "python3", str(bootstrap)],
            env=env,
            capture_output=True,
            text=True,
            check=False,
            timeout=120,
        )
        # Mirror `gaia install` Step 1a: seed agent_contract_permissions from
        # agent frontmatters (bootstrap.sh already seeds agent_permissions).
        seeder = _PACKAGE_ROOT / "tools" / "scan" / "seed_contract_permissions.py"
        if db.exists() and seeder.is_file():
            subprocess.run(
                [sys.executable or "python3", str(seeder), "--db-path", str(db)],
                env=env,
                capture_output=True,
                text=True,
                check=False,
                timeout=30,
            )
    except Exception:
        # Lazy bootstrap must never break the CLI.
        pass


def _discover_plugins():
    """Return a sorted list of (module_name, module) for all bin/cli/*.py plugins."""
    plugins = []
    if not _CLI_DIR.is_dir():
        return plugins

    for path in sorted(_CLI_DIR.glob("*.py")):
        if path.stem == "__init__":
            continue
        spec = importlib.util.spec_from_file_location(f"cli.{path.stem}", path)
        if spec is None:
            continue
        try:
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            plugins.append((path.stem, mod))
        except Exception as exc:  # noqa: BLE001
            print(f"Warning: could not load plugin {path.name}: {exc}", file=sys.stderr)

    return plugins


# ---------------------------------------------------------------------------
# Fast path: import ONE plugin instead of all ~28
# ---------------------------------------------------------------------------
#
# Profiling showed ``_discover_plugins()`` eagerly imports (exec_module) every
# bin/cli/*.py file on EVERY invocation, even ``gaia contract view`` or
# ``gaia history``, purely so argparse has every subparser registered. That
# cost is dominated by whichever plugin happens to carry an expensive
# module-level import (see bin/cli/metrics.py's now-lazy NATIVE_AGENT_NAMES),
# but even after that fix, importing 27 unrelated modules per invocation is
# pure waste for the overwhelmingly common case: ``gaia <subcmd> [args...]``
# where <subcmd> is a real, exactly-named subcommand.
#
# The fast path below imports ONLY the one bin/cli/<name>.py file matching
# argv[0] and builds a parser with ONLY that subcommand registered. It is
# used ONLY when argparse does not need the full subparser set to behave
# correctly, and declines (returns None / falls through) in every case where
# full parity requires it:
#   - empty argv                     -> top-level help lists every subcommand
#   - "-h"/"--help" anywhere in argv -> help text/formatting needs full context
#   - a leading flag (e.g. --json, --version) before the subcommand
#   - a first token that isn't a real plugin file (typo -- argparse's
#     "invalid choice" error must enumerate every valid subcommand)
#
# _discover_plugins() itself is UNCHANGED and still runs for every one of
# those fallback cases (and is what the CLI dispatcher's mutative-verb
# recognizer -- hooks/modules/security/mutative_verbs.py's
# _check_gaia_cli_dispatcher / _GAIA_DISPATCHER_SIGNATURE -- keys off of by
# literal name; it also keys off this module's "Unified Gaia CLI" docstring
# text above. Both markers are preserved verbatim by this change.
_FAST_PATH_DISABLE_ENV = "GAIA_CLI_NO_FAST_PATH"


def _fast_path_subcommand(argv):
    """Return the subcommand name ``argv`` unambiguously names, else ``None``.

    A ``None`` return means "fall back to full discovery" -- see the module
    comment above for the exact list of cases that decline.
    """
    if not argv:
        return None
    if any(a in ("-h", "--help") for a in argv):
        return None
    first = argv[0]
    if not first or first.startswith("-"):
        return None
    if not _CLI_DIR.is_dir():
        return None
    if not (_CLI_DIR / f"{first}.py").is_file():
        return None
    return first


def _load_single_plugin(stem):
    """Import exactly one bin/cli/<stem>.py plugin module, or None on failure.

    Deliberately silent on failure (unlike ``_discover_plugins``, which
    prints a warning): a failure here just means the fast path does not
    apply, and the caller falls back to ``_discover_plugins()``, which
    re-attempts the same import and prints the warning exactly once --
    matching pre-fast-path behavior byte-for-byte.
    """
    path = _CLI_DIR / f"{stem}.py"
    if not path.is_file():
        return None
    spec = importlib.util.spec_from_file_location(f"cli.{stem}", path)
    if spec is None:
        return None
    try:
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        return mod
    except Exception:  # noqa: BLE001
        return None


# ---------------------------------------------------------------------------
# Top-level epilog: the three lanes
# ---------------------------------------------------------------------------
#
# An alphabetical subcommand list answers "what exists" and leaves the reader
# with the question that actually matters: "which of these may I run myself?"
# A measured incident made the cost concrete -- an orchestrator blind-resumed
# four cut subagents while `gaia contract list --state DISPATCHED` (the exact
# verb that would have named them) sat inside its own allowlist, and read the
# absence of a known event reader as an absence of capability while `gaia
# query` and `gaia defects` were both available to it. Nothing was missing;
# nothing was discoverable.
#
# So the epilog is organized by LANE, not by name: what reads, what the
# coordinator itself may write, and what must be delegated -- with the owner
# named on every delegated line, because "you may not run this" is only
# actionable next to "they can". The read + coordinator-write lanes mirror
# ALLOWED_READ_PHRASES / ALLOWED_WRITE_PHRASES in
# hooks/modules/security/gaia_cli_only_guard.py; that guard is closed by
# default, so this text is a map OF the enforcement, never a second source of
# truth for it. When the allowlist changes, this epilog changes with it.
_EPILOG = """\
lanes -- what runs where, and who owns the rest:

READ -- changes nothing. The orchestrator runs these itself.
  contract       view | list | validate
                 `contract list --state DISPATCHED` names the turns that were
                 dispatched and never came back with a contract -- the way to
                 see cut subagents instead of blind-resuming them.
  query          THE event reader: one read-only query across curated memory,
                 agent episodes, and harness_events -- the hook event log,
                 one append-only row per hook firing.
  defects        row-level triage: subagent anomalies (episode_anomalies) and
                 the hook-log failures graded above `info`.
  doctor         health checks, read-only. `doctor --fix` MUTATES and is NOT
                 in this lane -- see `gaia doctor --help`.
  status         workspace status: agents, hooks, contracts.
  history        recent agent sessions.
  metrics        dashboard: tiers, commands, agents, anomalies.
  context        show | get | get-contract
                 `get-contract --section <s>` is the only verb that reads a
                 project-context contract row (the names an agent's
                 can_read/can_write kernel menu carries) -- a different
                 namespace from `show`/`get`'s workspace-shape --section.
  workspace      current | info
  evidence       show | list
  schedule       list | show | status
  brief          show | list | deps | search | verify
  plan           show | list
  task           list | show | gate list
  memory         search | show | list | stats | get-relevant | conflicts |
                 episode-show | story
  notifications  list | show
  approvals      list | pending | show | history | stats

WRITE the orchestrator owns -- coordination state, in bounded shapes.
  brief          new | edit | set-status | ac add|edit|remove
  plan           set-status
  task           set-status
  notifications  ack
  memory         add | append | reclassify | link | checkpoint
  scan           re-index this workspace's repos into (workspace, project)
                 rows -- how the coordinator keeps its own context current.
                 `scan --dry-run` previews the same result without writing.
  context scan   re-run the project scanner behind `context show`/`get`.
  paths          report the resolved storage paths (data, db, snapshot, logs,
                 events) and materialize the ~/.gaia layout if it is missing.
                 It reads like a read and is not one: all three handlers call
                 ensure_layout(), which creates those directories at 0700.

WRITE a specialist owns -- DELEGATE; do not run it here.
  gaia-operator  context wipe|prune-workspaces|move-contracts|move-memory|
                 move-project (destructive surgery on the substrate) |
                 workspace merge | schedule register|remove|sync
  gaia-system    install | update | uninstall | cleanup | dev | release
  consent flow   approvals approve|revoke|reject|reject-all|clean|replay|
                 request-set -- consent is granted by the user, not by a
                 CLI call
  owning agent   ac | milestone | evidence add | plan save|delete |
                 task add|remove|reorder | task gate add|remove|set-status |
                 contract set|add|fill|finalize

The READ lane and the orchestrator-WRITE lane above are the same set the
orchestrator CLI guard allows (hooks/modules/security/gaia_cli_only_guard.py).
That guard is closed by default: a verb absent from those two lanes is denied
for the orchestrator exactly like one that does not exist yet. Denial there is
not a missing feature -- it is work that belongs to the named owner.
"""


def _build_parser(plugin_entries):
    """Build the top-level ArgumentParser and register the given plugins.

    ``plugin_entries`` is a list of (name, module) pairs -- either the full
    set from ``_discover_plugins()`` or the single-entry fast path list.
    """
    parser = argparse.ArgumentParser(
        prog="gaia",
        description="Gaia unified CLI -- manage and inspect your Gaia installation.",
        epilog=_EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "--json",
        dest="global_json",
        action="store_true",
        default=False,
        help=(
            "Force JSON output for the invoked subcommand. Deliberately a "
            "DIFFERENT dest than any subcommand's own --json/--format: "
            "argparse's SubParsersAction parses each level into a FRESH "
            "namespace and then unconditionally overwrites the parent "
            "namespace's same-name attributes with the child's -- so a dest "
            "shared with a subcommand's own --json would silently reset a "
            "top-level `gaia --json <subcmd>` back to False the moment the "
            "subcommand parser applies its own (unset) default. Folded into "
            "the invoked subcommand's own output-shape flag by "
            "_apply_global_json() after parsing, which also fails loudly "
            "instead of silently doing nothing when the resolved subcommand "
            "exposes neither --json nor --format."
        ),
    )
    parser.add_argument(
        "--version",
        dest="show_version",
        action="store_true",
        default=False,
        help="Print version and exit",
    )

    subparsers = parser.add_subparsers(dest="subcommand", metavar="<subcommand>")
    for _name, mod in plugin_entries:
        if hasattr(mod, "register"):
            mod.register(subparsers)

    return parser


def _apply_global_json(args, argv):
    """Fold the top-level --json (parsed into args.global_json) into the
    invoked subcommand's own output-shape attribute.

    Returns an error message string when the resolved subcommand cannot honor
    --json at all -- caller prints it to stderr and exits non-zero. Returns
    None when nothing needs doing (global_json not set) or the merge
    succeeded. A subcommand's own trailing ``--json``/``--format=json``
    already works without this function; this only repairs the case where
    ``--json`` was given BEFORE the subcommand name, which argparse's
    subparser dispatch would otherwise silently drop (see the --json
    argument's own help text in _build_parser for why the dests are kept
    apart).

    ``argv`` (the raw arg list, not just ``args.subcommand``) is used only to
    phrase the error: it names the full verb chain the user typed (e.g.
    "task gate list"), not just the top-level subcommand name, which is all
    ``args.subcommand`` itself carries.
    """
    if not getattr(args, "global_json", False):
        return None

    if hasattr(args, "json"):
        args.json = True
        return None

    verb_chain = " ".join(a for a in argv if not a.startswith("-"))

    if hasattr(args, "format"):
        if args.format in (None, "json"):
            args.format = "json"
            return None
        return (
            f"gaia: --json conflicts with --format={args.format} for "
            f"'gaia {verb_chain}' -- pass only one."
        )

    return (
        f"gaia: 'gaia {verb_chain}' has no JSON output surface; --json is "
        f"not supported for this subcommand."
    )


def _run_with_plugins(argv, plugins):
    """Parse argv against ``plugins`` and dispatch. Shared by both paths."""
    parser = _build_parser(plugins)
    args = parser.parse_args(argv)

    if args.show_version:
        # Print version from package.json
        try:
            import json
            pkg = _PACKAGE_ROOT / "package.json"
            version = json.loads(pkg.read_text())["version"]
            print(f"gaia {version}")
        except Exception:
            print("gaia (version unknown)")
        return 0

    if args.subcommand is None:
        parser.print_help()
        return 0

    json_error = _apply_global_json(args, argv)
    if json_error is not None:
        print(json_error, file=sys.stderr)
        return 2

    # Lazy, non-invasive DB bootstrap -- replaces the removed npm postinstall.
    # Runs once, only when the resolved DB (see _resolve_db_path) is absent, and
    # never for the install/uninstall subcommands (see _LAZY_BOOTSTRAP_SKIP).
    _ensure_db_bootstrapped(args.subcommand)

    # Dispatch to the matching plugin handler
    for name, mod in plugins:
        if name == args.subcommand and hasattr(mod, f"cmd_{name}"):
            handler = getattr(mod, f"cmd_{name}")
            return handler(args) or 0

    # Subcommand registered but handler not found -- should not happen
    print(f"gaia: unknown subcommand '{args.subcommand}'", file=sys.stderr)
    return 1


def main(argv=None):
    """CLI entry point. Returns exit code."""
    raw_argv = sys.argv[1:] if argv is None else list(argv)

    if not os.environ.get(_FAST_PATH_DISABLE_ENV):
        fast_name = _fast_path_subcommand(raw_argv)
        if fast_name is not None:
            mod = _load_single_plugin(fast_name)
            if mod is not None:
                return _run_with_plugins(raw_argv, [(fast_name, mod)])
            # Fast-path import failed -- fall through to full discovery,
            # which re-attempts the same import and reports the warning.

    plugins = _discover_plugins()
    return _run_with_plugins(raw_argv, plugins)


if __name__ == "__main__":
    sys.exit(main())
