#!/usr/bin/env python3
"""
gaia -- Unified Gaia CLI

Entry point that discovers subcommand plugins from bin/cli/ and dispatches
to the matching handler. Zero external dependencies (stdlib only).

Usage:
    python bin/gaia <subcommand> [options]
    python bin/gaia --help
    python bin/gaia status [--json]
    python bin/gaia doctor [--json] [--fix]
"""

import argparse
import codecs
import importlib
import locale
import os
import subprocess
import sys
from pathlib import Path

# Ensure the package root is on sys.path so submodules resolve correctly.
_SCRIPT_DIR = Path(__file__).resolve().parent
_PACKAGE_ROOT = _SCRIPT_DIR.parent
if str(_PACKAGE_ROOT) not in sys.path:
    sys.path.insert(0, str(_PACKAGE_ROOT))
# Also ensure bin/ is on the path so bin/cli/ resolves as a package.
if str(_SCRIPT_DIR) not in sys.path:
    sys.path.insert(0, str(_SCRIPT_DIR))

_CLI_DIR = _SCRIPT_DIR / "cli"

# Subcommands that must NOT trigger the lazy DB bootstrap:
#   - install:   bootstraps the DB itself.
#   - uninstall: tearing Gaia down -- recreating the DB would be perverse.
#   - migrate:   moves the database between schema versions itself.
#   - now:       reads the clock only, and must work where no Gaia DB exists.
#   - lint:      measures a git diff and opens no database.
_LAZY_BOOTSTRAP_SKIP = frozenset({"install", "uninstall", "migrate", "now", "lint"})


def _resolve_db_path():
    """Resolve the gaia.db path the store itself will use.

    Delegates to ``gaia.paths.resolver.db_path``, the resolver the store uses,
    because the bootstrap below CREATES a database at whatever this returns: a
    second resolver would bootstrap one file and let the store use another. The
    fallback repeats the ladder (``GAIA_DB``, ``GAIA_DATA_DIR``, ``~/.gaia``)
    for when the import fails, since the bootstrap must never break the CLI.
    """
    try:
        from gaia.paths.resolver import db_path
        return db_path()
    except Exception:  # noqa: BLE001
        env = os.environ.get("GAIA_DB")
        if env:
            return Path(env).expanduser()
        data_dir = os.environ.get("GAIA_DATA_DIR")
        if data_dir:
            return Path(data_dir).expanduser() / "gaia.db"
        return Path("~/.gaia/gaia.db").expanduser()


def _ensure_db_bootstrapped(subcommand):
    """Lazily bootstrap the resolved gaia.db on first CLI use if it is absent.

    The path comes from ``_resolve_db_path()``, so what gets bootstrapped is the
    database the CLI will then use. It runs on first CLI use, not at package
    install time, so it does not depend on any package manager running a
    postinstall step. Best-effort and quiet: a failure never blocks the
    requested subcommand, which surfaces its own DB error.
    """
    if subcommand in _LAZY_BOOTSTRAP_SKIP:
        return
    try:
        db = _resolve_db_path()
        if db.exists():
            return
        bootstrap = _PACKAGE_ROOT / "scripts" / "bootstrap_database.py"
        if not bootstrap.is_file():
            return
        env = os.environ.copy()
        env["GAIA_DB"] = str(db)
        subprocess.run(
            [sys.executable or "python3", str(bootstrap)],
            env=env,
            capture_output=True,
            text=True,
            check=False,
            timeout=120,
        )
        # As `gaia install` does: seed agent_contract_permissions from the agent frontmatters.
        seeder = _PACKAGE_ROOT / "tools" / "scan" / "seed_contract_permissions.py"
        if db.exists() and seeder.is_file():
            subprocess.run(
                [sys.executable or "python3", str(seeder), "--db-path", str(db)],
                env=env,
                capture_output=True,
                text=True,
                check=False,
                timeout=30,
            )
    except Exception:
        # Lazy bootstrap must never break the CLI.
        pass


def _is_plugin_stem(stem):
    """True for a bin/cli/<stem>.py that is a subcommand; `_`-prefixed files are helpers plugins import."""
    return not stem.startswith("_")


def _import_plugin(stem):
    """Import bin/cli/<stem>.py as ``cli.<stem>``, the module plugins and tests import too."""
    return importlib.import_module(f"cli.{stem}")


def _discover_plugins():
    """Return a sorted list of (module_name, module) for all bin/cli/*.py plugins."""
    plugins = []
    if not _CLI_DIR.is_dir():
        return plugins

    for path in sorted(_CLI_DIR.glob("*.py")):
        if not _is_plugin_stem(path.stem):
            continue
        try:
            plugins.append((path.stem, _import_plugin(path.stem)))
        except Exception as exc:  # noqa: BLE001
            print(f"Warning: could not load plugin {path.name}: {exc}", file=sys.stderr)

    return plugins


# The fast path imports only the bin/cli/<name>.py named by argv[0] and registers
# only that subcommand, instead of importing every plugin. It declines, and the
# full discovery runs, when argparse needs every subparser: empty argv, -h/--help
# anywhere, a leading flag, or a first token that is not a plugin file (the
# "invalid choice" error enumerates them all).
#
# Hooks recognize this dispatcher by the text "Unified Gaia CLI" in the module
# docstring and the name _discover_plugins (_GAIA_DISPATCHER_SIGNATURE in
# hooks/modules/security/mutative_verbs.py and gaia_cli_invocation.py); renaming
# either changes how bin/gaia is classified.
_FAST_PATH_DISABLE_ENV = "GAIA_CLI_NO_FAST_PATH"


def _fast_path_subcommand(argv):
    """Return the subcommand name ``argv`` unambiguously names, else ``None`` (full discovery)."""
    if not argv:
        return None
    if any(a in ("-h", "--help") for a in argv):
        return None
    first = argv[0]
    if not first or first.startswith("-") or not _is_plugin_stem(first):
        return None
    if not _CLI_DIR.is_dir():
        return None
    if not (_CLI_DIR / f"{first}.py").is_file():
        return None
    return first


def _load_single_plugin(stem):
    """Import exactly one bin/cli/<stem>.py plugin module, or None on failure.

    Silent on failure: the caller then runs ``_discover_plugins()``, which
    retries the import and prints the warning once.
    """
    if not (_CLI_DIR / f"{stem}.py").is_file():
        return None
    try:
        return _import_plugin(stem)
    except Exception:  # noqa: BLE001
        return None


# The READ lane must equal ALLOWED_READ_PHRASES plus ALLOWED_BARE_READ_FLAGS, and
# the coordinator-WRITE lane must equal ALLOWED_WRITE_PHRASES, in
# hooks/modules/security/gaia_cli_only_guard.py.
# tests/cli/test_help_lanes_match_guard.py parses these two lanes from the
# printed help and fails on drift either way, so a lane row keeps its grammar:
# two-space indent, the command head, then on the SAME line only its verb spec
# (`a | b` alternatives, `x|y` within a token, a trailing `|` continues onto
# the next line; empty for the bare command); prose goes on deeper lines.
_EPILOG = """\
lanes -- what runs where, and who owns the rest:

READ -- changes nothing. The orchestrator runs these itself.
  --version
                 the installed gaia version, as the only argument.
  now
                 local time, UTC offset and zone; read it before computing an absolute --at.
  map
                 what is live now (due reminders, pending proposals, turns never
                 closed, unread signals, active plans) with the verb that moves
                 each, the five habits, and which capability serves an intent;
                 `map <intent>` expands one row. A name you cannot place:
                 `map <word>` says which workspace, group or project it is.
  signals
                 the curated changes behind a `~ changed:` line, each with the
                 command that opens it.
  open
                 `open KIND:SCOPE/ID#FIELD` opens anything Gaia stores by one
                 reference (any id spelling); `--line` prints only its why line,
                 `--json` the whole resolution.
  contract       view | list | validate | proposals list
                 `contract list --state DISPATCHED` names the turns that were
                 dispatched and never came back with a contract -- the way to
                 see cut subagents instead of blind-resuming them.
                 `contract proposals list` shows what closed turns proposed
                 (memory, context, thread) and nobody has decided yet.
  query
                 THE event reader: one read-only query across curated memory,
                 agent episodes, and harness_events -- the hook event log,
                 one append-only row per hook firing.
  defects
                 row-level triage: subagent anomalies (episode_anomalies) and
                 the hook-log failures graded above `info`.
  doctor
                 health checks, read-only. `--channels` is the install state
                 per channel, `--target <version>` the steps to reach a version.
                 `doctor --fix` MUTATES and is NOT in this lane.
  migrate        plan
                 the pending schema change and the backups on hand; `apply` and
                 `restore` write and are not in this lane.
  status
                 workspace status: agents, hooks, contracts.
  history
                 recent agent sessions.
  metrics
                 dashboard: tiers, commands, agents, anomalies.
  usage          show
                 `--plan N` or `--session ID`: tokens per session and per
                 agent from Claude Code transcripts; for a plan, split bound /
                 unbound / main. What a task or re-dispatch cost, where a
                 plan's spend went.
  context        show | get | get-contract | project
                 `get-contract --section <s>` is the only verb that reads a
                 project-context contract row (the names an agent's
                 can_read/can_write kernel menu carries) -- a different
                 namespace from `show`/`get`'s workspace-shape --section.
                 `project <name>` is the one-project ficha: row, facets, the
                 matching project_identity contract entry, and a
                 curated-memory index (slug + description, never a body).
  workspace      current | info
  evidence       show | list
  brief         show | list | deps | search | verify | decision list | history
  plan           show | list | history | change list
  task           list | show | gate list
  memory         search | show | list | stats | get-relevant | conflicts |
                 episode-show | story
  notifications  list | show
  approvals      list | pending | show | question | history | stats
  worktree       list | show | show-capture
                 inspect a specialist's own isolated git worktree (never
                 create or release it -- those are the specialist's own
                 governed writes, below).
  session        preview | snapshot
                 render the SessionStart manifest in-process.
  lint           comments
                 net comment lines a branch adds against max(2, 2% of its added
                 code); run it on a diff before presenting its push.

WRITE the orchestrator owns -- coordination state, in bounded shapes.
  brief          new | edit | set-status (not closed) | close | set-project |
                 ac add|edit|remove | decision add
                 close verifies first, syncs the ACs that compute done and
                 closes the plan and the brief, or refuses and writes nothing.
  plan           set-status (not closed) | pause | resume | change request|approve
                 steer the plan without judging or authoring it: the planner
                 proposes and applies a change, a verifier records verdicts.
  task           set-status (no --override) | gate reverify
  session        resume-point set
  notifications  ack | add | snooze | cancel
                 add is a reminder or routine only (--at, --cron or --every);
                 snooze and cancel take ONE id.
  approvals      reject | revoke | request-set
                 reject and revoke withdraw ONE approval by id, taking back
                 consent Gaia issued; request-set phrases a signature your own
                 denial asked for. Granting and sweeping stay outside this lane.
  memory         add | append | reclassify | move | link | checkpoint | declare
                 declare is T3: the user signs what the hooks will conclude.
  scan
                 re-index this workspace's repos into (workspace, project)
                 rows -- how the coordinator keeps its own context current.
                 `scan --dry-run` previews the same result without writing.
  context        scan | accept
                 re-run the project scanner behind `context show`/`get`.
                 `context accept CONTRACT_ID` writes the update_contracts
                 proposal a specialist's close announced, each key in the
                 workspace that owns its project.
  contract       proposals accept | proposals dismiss
                 decide ONE pending proposal by id: accept writes it (pass
                 --project when the proposing turn had none), dismiss drops it.
  paths
                 report the resolved storage paths (data, db, snapshot, logs,
                 events) and materialize the ~/.gaia layout if it is missing.
                 It reads like a read and is not one: all three handlers call
                 ensure_layout(), which creates those directories at 0700.

WRITE a specialist owns -- DELEGATE; do not run it here.
  gaia-operator  context wipe|prune-workspaces|move-contracts|move-memory|
                 move-project (destructive surgery on the substrate) |
                 workspace declare|curate|merge|retire |
                 project move |
                 usage ingest (load transcripts into token_usage)
  gaia-system    install | update | uninstall | cleanup | dev | release |
                 migrate plan|apply (install, update and dev run apply)
  consent flow   approvals approve|reject-all|clean|replay|request-set --
                 consent is granted by the user, not by a CLI call
  owning agent   ac | milestone | evidence add | plan save|delete |
                 plan change propose|apply (planner) |
                 task add|remove|reorder|cover|depend (planner) |
                 task gate add|remove|set-status |
                 contract set|add|fill|finalize |
                 worktree create|release|prune-branches -- create/release its
                 OWN isolated git worktree, or prune the branches whose content
                 is already integrated (T0 at the tier layer -- see
                 COMMAND_SUBCOMMAND_TIER_EXCEPTIONS in mutative_verbs.py --
                 but still outside the orchestrator's bare CLI lane)

The READ lane and the orchestrator-WRITE lane above are the same set the
orchestrator CLI guard allows (hooks/modules/security/gaia_cli_only_guard.py).
That guard is closed by default: a verb absent from those two lanes is denied
for the orchestrator exactly like one that does not exist yet. Denial there is
not a missing feature -- it is work that belongs to the named owner.
"""


def _build_parser(plugin_entries):
    """Build the top-level ArgumentParser and register the given plugins.

    ``plugin_entries`` is a list of (name, module) pairs -- either the full
    set from ``_discover_plugins()`` or the single-entry fast path list.
    """
    parser = argparse.ArgumentParser(
        prog="gaia",
        description="Gaia unified CLI -- manage and inspect your Gaia installation.",
        epilog=_EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "--json",
        dest="global_json",
        action="store_true",
        default=False,
        help=(
            "Force JSON output for the invoked subcommand. Deliberately a "
            "DIFFERENT dest than any subcommand's own --json/--format: "
            "argparse's SubParsersAction parses each level into a FRESH "
            "namespace and then unconditionally overwrites the parent "
            "namespace's same-name attributes with the child's -- so a dest "
            "shared with a subcommand's own --json would silently reset a "
            "top-level `gaia --json <subcmd>` back to False the moment the "
            "subcommand parser applies its own (unset) default. Folded into "
            "the invoked subcommand's own output-shape flag by "
            "_apply_global_json() after parsing, which also fails loudly "
            "instead of silently doing nothing when the resolved subcommand "
            "exposes neither --json nor --format."
        ),
    )
    parser.add_argument(
        "--version",
        dest="show_version",
        action="store_true",
        default=False,
        help="Print version and exit",
    )

    subparsers = parser.add_subparsers(dest="subcommand", metavar="<subcommand>")
    for _name, mod in plugin_entries:
        if hasattr(mod, "register"):
            mod.register(subparsers)

    from gaia.cli_parsing import refuse_abbreviations

    return refuse_abbreviations(parser)


def _apply_global_json(args, argv):
    """Fold the top-level --json (parsed into args.global_json) into the
    invoked subcommand's own output-shape attribute.

    Returns an error message string when the resolved subcommand cannot honor
    --json at all -- caller prints it to stderr and exits non-zero. Returns
    None when nothing needs doing (global_json not set) or the merge
    succeeded. A subcommand's own trailing ``--json``/``--format=json``
    already works without this function; this only repairs the case where
    ``--json`` was given BEFORE the subcommand name, which argparse's
    subparser dispatch would otherwise silently drop (see the --json
    argument's own help text in _build_parser for why the dests are kept
    apart).

    ``argv`` (the raw arg list, not just ``args.subcommand``) is used only to
    phrase the error: it names the full verb chain the user typed (e.g.
    "task gate list"), not just the top-level subcommand name, which is all
    ``args.subcommand`` itself carries.
    """
    if not getattr(args, "global_json", False):
        return None

    if hasattr(args, "json"):
        args.json = True
        return None

    verb_chain = " ".join(a for a in argv if not a.startswith("-"))

    if hasattr(args, "format"):
        if args.format in (None, "json"):
            args.format = "json"
            return None
        return (
            f"gaia: --json conflicts with --format={args.format} for "
            f"'gaia {verb_chain}' -- pass only one."
        )

    return (
        f"gaia: 'gaia {verb_chain}' has no JSON output surface; --json is "
        f"not supported for this subcommand."
    )


# Env vars the host may export to advertise the session id, in the same
# precedence as _SESSION_ID_ENV_VARS in bin/cli/doctor.py.
_CONTRACT_SESSION_ID_ENV_VARS = ("CLAUDE_CODE_SESSION_ID", "CLAUDE_SESSION_ID")


def _fill_contract_finalize_session_id(args, mod) -> None:
    """Best-effort default for an unattributed ``gaia contract finalize``.

    ``bin/cli/contract.py`` and ``gaia/contract/drafts.py`` may not read a
    host env var (the AST guard in ``tests/contract/test_cli_draft_key.py``), so
    this launcher supplies the session id for a turn that finalizes with no
    ``--session-id``. An explicit ``--session-id`` wins, and with neither var
    exported ``args.session_id`` stays ``None``. Scoped to ``cmd_finalize`` by
    function identity so the ``--session`` filter of ``gaia contract list``
    (same ``session_id`` dest) is untouched.
    """
    if getattr(args, "func", None) is not getattr(mod, "cmd_finalize", None):
        return
    if getattr(args, "session_id", None):
        return
    for var in _CONTRACT_SESSION_ID_ENV_VARS:
        val = os.environ.get(var)
        if val:
            args.session_id = val
            return


def _run_with_plugins(argv, plugins):
    """Parse argv against ``plugins`` and dispatch. Shared by both paths."""
    parser = _build_parser(plugins)
    args = parser.parse_args(argv)

    if args.show_version:
        try:
            import json
            pkg = _PACKAGE_ROOT / "package.json"
            version = json.loads(pkg.read_text())["version"]
            print(f"gaia {version}")
        except Exception:
            print("gaia (version unknown)")
        return 0

    if args.subcommand is None:
        parser.print_help()
        return 0

    json_error = _apply_global_json(args, argv)
    if json_error is not None:
        print(json_error, file=sys.stderr)
        return 2

    _ensure_db_bootstrapped(args.subcommand)

    for name, mod in plugins:
        if name == args.subcommand and hasattr(mod, f"cmd_{name}"):
            handler = getattr(mod, f"cmd_{name}")
            if name == "contract":
                _fill_contract_finalize_session_id(args, mod)
            return handler(args) or 0

    # Subcommand registered but handler not found -- should not happen
    print(f"gaia: unknown subcommand '{args.subcommand}'", file=sys.stderr)
    return 1


def main(argv=None):
    """CLI entry point. Returns exit code."""
    raw_argv = sys.argv[1:] if argv is None else list(argv)
    os.environ.setdefault("GAIA_STORE_ENTRY_POINT", "bin/gaia")

    if not os.environ.get(_FAST_PATH_DISABLE_ENV):
        fast_name = _fast_path_subcommand(raw_argv)
        if fast_name is not None:
            mod = _load_single_plugin(fast_name)
            if mod is not None:
                return _run_with_plugins(raw_argv, [(fast_name, mod)])
            # Fast-path import failed -- fall through to full discovery,
            # which re-attempts the same import and reports the warning.

    plugins = _discover_plugins()
    return _run_with_plugins(raw_argv, plugins)


def _ensure_utf8_mode():
    """Restart this CLI under Python's UTF-8 mode when its text codec is not UTF-8.

    npm's shim and a bare ``python bin/gaia`` start the interpreter with the
    locale codec, which decodes UTF-8 argv, stdin, files and git output as
    mojibake on cp1252 Windows. A UTF-8 locale already decodes correctly and is
    left alone: the orchestrator runs this CLI hundreds of times a session.
    Windows has no exec, so there the child is awaited and its exit code relayed.
    """
    if sys.flags.utf8_mode or not sys.executable:
        return
    if codecs.lookup(locale.getpreferredencoding(False)).name == "utf-8":
        return
    os.environ["PYTHONUTF8"] = "1"
    argv = [sys.executable, "-X", "utf8", *sys.orig_argv[1:]]
    if os.name == "nt":
        sys.exit(subprocess.call(argv))
    os.execv(sys.executable, argv)


if __name__ == "__main__":
    _ensure_utf8_mode()
    sys.exit(main())
