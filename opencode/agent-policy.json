{
  "authority": {
    "host_reachability_owner": "HOST",
    "effect_consent_owner": "GAIA",
    "precedence": "HOST may prevent a call from reaching Gaia, but HOST never emits or substitutes a Gaia verdict. Once reachable, Gaia alone decides consent and protected-path policy.",
    "host_short_circuit_gap": {
      "status": "ACCEPTED_DOCUMENTED_GAP",
      "owner": "HOST",
      "gaia_consulted": false,
      "gaia_verdict": null,
      "surfaces": [
        "external_directory"
      ]
    }
  },
  "default": {
    "mode": "subagent",
    "host_capabilities": []
  },
  "gaia-orchestrator": {
    "mode": "primary",
    "permission": {
      "bash": {
        "*": "deny",
        "gaia *": "allow"
      },
      "task": {
        "*": "deny",
        "cloud-troubleshooter": "allow",
        "developer": "allow",
        "gaia-operator": "allow",
        "gaia-planner": "allow",
        "gaia-system": "allow",
        "gaia-verifier": "allow",
        "gitops-operator": "allow",
        "platform-architect": "allow"
      },
      "edit": "deny",
      "glob": "deny",
      "grep": "deny"
    }
  },
  "gaia-system": {
    "mode": "subagent",
    "host_capabilities": [
      "canonical_gaia_scratch"
    ]
  }
}
